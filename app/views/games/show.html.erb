<div class="min-h-screen bg-gray-50" data-controller="chain">
  <%# === LP/KP カウンター === %>
  <div class="bg-white shadow-sm border-b sticky top-0 z-10">
    <div class="max-w-md mx-auto px-4 py-2">
      <div class="flex items-center justify-between mb-1">
        <h1 class="text-sm font-bold text-red-800">Ruby Chains</h1>
        <%= link_to "新しいゲーム", new_game_path, class: "text-xs text-gray-500 underline" %>
      </div>
      <div class="space-y-1">
        <% @game.game_players.each do |player| %>
          <div id="player_counter_<%= player.id %>">
            <%= render "player_counter", player: player %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="max-w-md mx-auto px-4 py-4 space-y-4">
    <%# === レシーバー選択 === %>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">レシーバー</label>
      <select data-chain-target="receiverSelect"
              data-action="change->chain#onReceiverChange"
              class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white">
        <option value="">選択してください</option>
        <% @receiver_cards.each do |card| %>
          <option value="<%= card.id %>" data-label="<%= card.label %>"><%= card.label %> (<%= card.type_name %>)</option>
        <% end %>
      </select>
    </div>

    <%# === チェイン表示 === %>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">チェイン</label>
      <div data-chain-target="chainDisplay"
           class="bg-white border border-gray-200 rounded p-3 min-h-[48px] flex flex-wrap items-center gap-1 text-sm font-mono">
        <span class="text-gray-400">レシーバーを選択してください</span>
      </div>
    </div>

    <%# === メソッドカード一覧 === %>
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-1">メソッドカード</label>
      <% { "A" => "主力", "B" => "ユーティリティ", "C" => "ジェネレーター", "D" => "切り札" }.each do |cat, label| %>
        <% cards = @method_cards_by_category[cat] || [] %>
        <% next if cards.empty? %>
        <details class="mb-2" <%= "open" if cat == "A" %>>
          <summary class="text-xs font-medium text-gray-600 cursor-pointer py-1"><%= cat %>. <%= label %></summary>
          <div class="flex flex-wrap gap-1 mt-1">
            <% cards.each do |card| %>
              <button type="button"
                      class="px-2 py-1 rounded text-xs border transition-colors
                             <%= card.wild? ? 'border-amber-400 bg-amber-50 text-amber-800 hover:bg-amber-100' : 'border-gray-300 bg-white text-gray-700 hover:bg-gray-100' %>"
                      data-action="click->chain#addMethod"
                      data-card-id="<%= card.id %>"
                      data-card-name="<%= card.name %>"
                      data-wild="<%= card.wild? %>">
                <%= card.name %>
              </button>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>

    <%# === 実行ボタン === %>
    <button type="button"
            data-action="click->chain#execute"
            data-chain-target="executeBtn"
            class="w-full bg-red-700 text-white py-3 rounded-lg font-medium hover:bg-red-800 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            disabled>
      実行
    </button>

    <%# === 結果表示 === %>
    <div data-chain-target="resultArea" class="hidden">
    </div>
  </div>

  <%# === 切り札モーダル === %>
  <div data-chain-target="wildModal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-end justify-center">
    <div class="bg-white w-full max-w-md rounded-t-xl p-4 pb-8 max-h-[70vh] overflow-y-auto">
      <h3 class="text-sm font-bold mb-3 text-gray-800">切り札の使い方を選択</h3>
      <button type="button"
              data-action="click->chain#wildIdentity"
              class="w-full text-left px-3 py-2 rounded border border-gray-200 mb-2 text-sm hover:bg-gray-50">
        単体で出す <span class="text-gray-400">{ |it| it }</span>
      </button>
      <div class="mb-2">
        <p class="text-xs text-gray-500 mb-1">Proc引数と組み合わせる (&amp;:method)</p>
        <div class="flex flex-wrap gap-1">
          <% @proc_compatible_cards.each do |card| %>
            <button type="button"
                    data-action="click->chain#wildWithProc"
                    data-proc-id="<%= card.id %>"
                    data-proc-name="<%= card.name %>"
                    class="px-2 py-1 rounded text-xs border border-blue-300 bg-blue-50 text-blue-800 hover:bg-blue-100">
              &amp;:<%= card.code_fragment.delete_prefix(".") %>
            </button>
          <% end %>
        </div>
      </div>
      <button type="button" data-action="click->chain#closeWildModal"
              class="mt-3 w-full py-2 text-sm text-gray-500 border rounded hover:bg-gray-50">
        キャンセル
      </button>
    </div>
  </div>

  <%# メタデータ %>
  <template data-chain-target="meta"
            data-game-id="<%= @game.id %>"
            data-execute-url="<%= execute_game_path(@game) %>"
            data-csrf="<%= form_authenticity_token %>">
  </template>
</div>
