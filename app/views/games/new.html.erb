<div class="min-h-screen bg-gray-50 flex items-center justify-center p-4">
  <div class="w-full max-w-md bg-white rounded-lg shadow-md p-6">
    <h1 class="text-2xl font-bold text-center text-red-800 mb-6">Ruby Chains</h1>
    <p class="text-sm text-gray-600 text-center mb-6">メソッドチェイン判定補助ツール</p>

    <%= form_with url: games_path, method: :post, data: { controller: "player-form" } do |f| %>
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-2">プレイヤー人数</label>
        <div class="flex gap-2" data-player-form-target="countButtons">
          <% (2..4).each do |n| %>
            <button type="button"
                    class="flex-1 py-2 rounded border text-sm font-medium transition-colors"
                    data-action="click->player-form#setCount"
                    data-count="<%= n %>"
                    data-player-form-target="countBtn">
              <%= n %>人
            </button>
          <% end %>
        </div>
        <input type="hidden" name="player_count" value="2" data-player-form-target="countInput">
      </div>

      <div class="mb-4" data-player-form-target="nameFields">
        <label class="block text-sm font-medium text-gray-700 mb-2">プレイヤー名（任意）</label>
        <% 4.times do |i| %>
          <div class="mb-2 player-name-field" data-index="<%= i %>" style="<%= 'display:none' if i >= 2 %>">
            <input type="text"
                   name="player_names[<%= i %>]"
                   placeholder="プレイヤー<%= i + 1 %>"
                   class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-red-300">
          </div>
        <% end %>
      </div>

      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">初期LP</label>
        <select name="initial_lp" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
          <% (8..12).each do |lp| %>
            <option value="<%= lp %>" <%= "selected" if lp == 10 %>><%= lp %></option>
          <% end %>
        </select>
      </div>

      <button type="submit" class="w-full bg-red-700 text-white py-3 rounded-lg font-medium hover:bg-red-800 transition-colors">
        ゲーム開始
      </button>
    <% end %>
  </div>
</div>
